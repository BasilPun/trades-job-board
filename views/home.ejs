<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Home' }) %>
    
    <link rel = "stylesheet" href = "/styles/global.css">
    <link rel = "stylesheet" href = "/styles/home-style.css">
    <script src = "/scripts/home-script.js" defer></script>

</head>
<body>
    <header>
        <a class="site-name" href="/">Trades Job Board</a>
        <div id ="login-box">
            <h2>Log In</h2>
            <a href="/login">
                <button id="login">Login</button>
            </a>
            <a href="/signup">
                <button id="signup">Signup</button>
            </a>
        </div>
    </header>
    <main>
        <h1>Choose Your Trade!</h1>
        <p>Welcome to the GRC Trades Job board!</p>
        <p>Click on your Specialty and browse Available Jobs!</p>
        <div id = "trades-container">
            <a href="/job-board?trade=welding">Welding</a>
            <a href="/job-board?trade=automotive">Automotive</a>
            <a href="/job-board?trade=manufacturing">Manufacturing</a>
            <a href="/job-board?trade=carpentry">Carpentry</a>
            <a href="/job-board?trade=mechatronics">Mechatronics</a>
        </div>
    </main>
        <footer>
            <p>Green River College — Trades Job Board</p>
        </footer>
</body>
</html>