<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Find Jobs' }) %>

    <!-- Must come first -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <!-- Add data table information -->
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel = "stylesheet" href = "/styles/job-board-style.css">
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <h1><span id = "capitalise"><%=selectedTrade%></span> Job Board</h1>

        <table id="job-table" class="display">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Compensation</th>
                    <th>Trade</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Posted Date</th>
                    <th>Expiry Date</th>
                    <th>Job Age</th>
                    <th>isExpired</th>
                    <th>Location</th>
                    <th>Link</th>
                    <th>Data Created at</th>
                </tr>
            </thead>

            <tbody>
                <% const current_date = new Date(); %>
                <% jobs.forEach(job => { %>
                    <% const start_date = new Date(job['start-date']); %>
                    <% const end_date = new Date(job['end-date']); %>
                    <% const time_difference = current_date - start_date; %>
                    <% let jobAge =   time_difference / (1000 * 60 * 60 * 24);%>
                    <% jobAge = Math.floor(jobAge); //round it down to ints %>
                    <% const isExpired = current_date > end_date; %>
                    <% if (job.trade == selectedTrade && isExpired === false){ %>
                        <tr>
                            <td> <%= job['job-title']%> </td>
                            <td> <%= job['company-name']%> </td>
                            <td><%= job['compensation']%></td>
                            <td> <%= job['trade']%> </td>
                            <td><%= job['job-desc']%></td>
                            <td><%= job['job-type']%></td>
                            <td><%= job['start-date']%></td>
                            <td><%= job['end-date']%></td>
                            <td><%= jobAge %></td>
                            <td><%= isExpired %></td>
                            <td><%= job['job-location']%></td>
                            <td>
                                <a href="<%= job['job-link'] %>" target="_blank" rel="noopener noreferrer">Apply Now</a>
                            </td>
                            <td><%= job['timestamp'].toLocaleString()%></td>
                        </tr>
                <% }}); %>

            </tbody>
        </table>
    </main>
    <footer>
        <p>Green River College — Trades Job Board</p>
    </footer>
<script>
    new DataTable('#job-table', {
        responsive: true,
        order: [[6, 'desc']], // Orders by latest posting by default
        columnDefs: [
            {
                // Apply Now column
                targets: 8,
                // Disable sorting
                orderable: false
            }
        ]
    });
</script>
</body>
</html>