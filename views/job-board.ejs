<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Find Jobs' }) %>

    <!-- Must come first -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <!-- Add data table information -->
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel = "stylesheet" href = "/styles/job-board-style.css">
</head>
<body>
    <header>
        <a class="site-name" href="/">Trades Job Board</a>
        <div id ="login-box">
            <h2>Log In</h2>
            <a href="/login">
                <button id="login">Login</button>
            </a>
            <a href="/signup">
                <button id="signup">Signup</button>
            </a>
        </div>
    </header>
    <main>
        <h1><span id = "capitalise"><%=selectedTrade%></span> Job Board</h1>

        <table id="job-table" class="display">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Compensation</th>
                    <th>Trade</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Posted Date</th>
                    <th>Expiry Date</th>
                    <th>Location</th>
                    <th>Link</th>
                    <th>Data Created at</th>
                </tr>
            </thead>

            <tbody>
                <% jobs.forEach(job => { %>
                <% if (job.trade == selectedTrade){ %>
                    <tr>
                        <td> <%= job['job-title']%> </td>
                        <td><%= job['compensation']%></td>
                        <td> <%= job['trade']%> </td>
                        <td><%= job['job-desc']%></td>
                        <td><%= job['job-type']%></td>
                        <td><%= job['start-date']%></td>
                        <td><%= job['end-date']%></td>
                        <td><%= job['job-location']%></td>
                        <td>
                            <a href="<%= job['job-link'] %>" target="_blank" rel="noopener noreferrer">Apply Now</a>
                        </td>
                        <td><%= job['timestamp'].toLocaleString()%></td>
                    </tr>
                <% }}); %>

            </tbody>
        </table>
    </main>
    <footer>
        <p>Green River College — Trades Job Board</p>
    </footer>
<script>
    new DataTable('#job-table', {
        responsive: true,
        columnDefs: [
            {
                // Apply Now column
                targets: 8,
                // Disable sorting
                orderable: false
            }
        ]
    });
</script>
</body>
</html>