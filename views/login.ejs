<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Login' }) %>
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/login.css">
</head>
<body>
    <main>
        <h1>Log in to your account</h1>

        <form id="login-form" action="/login" method="post">
            <div class="login-username-container">
                <label for="username">Username</label>
                <input type="text" id="username" name="username">
                <span class="err" id="err-username">Username is required</span>
            </div>

            <div class="login-password-container">
                <label for="password">Password</label>
                <input type="password" id="password" name="password">
                <span class="err" id="err-password">Password is required</span>
            </div>

            <button type="submit" id="login-button" class="green-button">Login</button>
        </form>

        <div class="signup-box">
            <p>Don't have an account?</p>
            <a href="/signup" class="green-button">Sign up</a>
        </div>
    </main>
</body>
</html>