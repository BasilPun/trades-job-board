<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Job Posted' }) %>
    <link rel = "stylesheet" href = "/styles/add-job-summary-style.css">

</head>
<body>
    <main>
        <div id = "header">
            <h1>Job has been posted</h1>
            <p>Summary of job posted</p>
        </div>
        <div id = "general-info">
            <h2>General Info</h2>
            <p>Job title: <%= job['job-title'] %></p>
            <p>Trade: <%= job['trade'] %></p>J
            <p>Compensation: <%= job['compensation'] %></p>
            <p>Job Description: <%= job['job-desc'] %></p>
            <p>Job type: <%= job['job-type'] %></p>
        </div>
        <div id = "specifics">
            <h2>Important Specifics</h2>
            <p>Job posted at: <%= job['start-date'] %></p>
            <p>Job posting end date: <%= job['end-date']%></p>
            <p>Job location: <%= job['job-location'] %></p>
            <p>Job link: <%= job['job-link'] %></p>
            <p>Data created at: <%=job['timestamp'].toLocaleString()%></p>
        </div>

         <div id = "button-box">
            <a href = "/admin">
                <button id = "admin">View all jobs</button>
            </a>
            <a href = "/add-job">
                <button id = "add-job">Add another job</button>
            </a>
        </div>
    </main>
</body>
</html>