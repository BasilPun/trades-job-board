<!DOCTYPE html>
<html lang = "en">
<head>
    <%- include('partials/head', { pageTitle: 'Post a Job' }) %>
    <!-- <link rel = "icon" href = "../images/pizza-favicon.png"> -->
    <link rel="stylesheet" href="/styles/global.css">
    <link rel = "stylesheet" href = "/styles/add-job-style.css">
    <script src = "/scripts/add-job-script.js" defer></script>
</head>
<body>
    <main>
        <h1 id = "header">Add a Job</h1>

        <form id = "add-job-form" action = "/add-job-summary" method = "post">
            <div id = "job-title-box">
                <label for = "job-title">Job Title</label>
                <input type = "text" id = "job-title" name = "job-title">
                <span class = "err" id = "err-job-title">Job title is required</span>
            </div>

            <div id = "compensation-box">
                <label for = "compensation">Compensation</label>
                <input type = "number" id = "compensation" name = "compensation">
            </div>

            <div id = "job-desc-box">
                <label for = "job-desc">Job Description</label>
                <textarea rows = "5" id = "job-desc" name = "job-desc"></textarea>
            </div>

            <div id = "date-box">
                <div id = "start-date-box">
                    <label for = "start-date">Post Date</label>
                    <input type = "date" id = "start-date" name = "start-date">
                    <span class = "err" id = "err-start-date">Posting's post date required</span>
                </div>

                <div id = "end-date-box">
                    <label for = "end-date">End Date</label>
                    <input type = "date" id = "end-date" name = "end-date">
                    <span class = "err" id = "err-end-date">Enter a valid end date</span>
                </div>
            </div>

            <div id="hours-box">
                <h2>Hours</h2>
                <div id ="hours-box-2">
                    <div id = "hour-type">
                        <label for="part-time">
                            <input type="radio" id="part-time" name="job-type" value="part-time">
                            Part-time
                        </label>

                        <label for="full-time">
                            <input type="radio" id="full-time" name="job-type" value="full-time">
                            Full-time
                        </label>
                        <span class="err" id="err-hour-type">Select Hours</span>
                    </div>

                    <div id = "internship-box">
                        <label for="is_internship">
                            <input type="checkbox" id="is_internship" name="is_internship" value="internship">
                            Is it an Internship?
                        </label>
                    </div>
                </div>
            </div>
            
            <div id="location-box">
                <h2>Job Location</h2>
                <div id = "location-box-2">
                    <div id = "job-state-box">
                        <label for="job-state">State</label>
                        <select id="job-state" name="job-state" disabled>
                            <option value="WA">WA</option>
                        </select>
                    </div>

                    <div id = "job-city-box">
                        <label for="job-city">City</label>
                        <select id="job-city" name="job-city">
                            <option value="none">Select City</option>

                                <% wa_cities.forEach(city => { %>
                                <option value="<%= city.name %>">
                                    <%= city.name %>
                                </option>

                            <% }); %>
                        </select>
                        <span class="err" id="err-job-city">Job city is required</span>
                    </div>
                </div>
            </div>

            <div id = "link-box">
                <label for = "job-link">Job Posting Link</label>
                <input type = "url" id = "job-link" name = "job-link">
                <span class = "err" id = "err-job-link">Enter a valid URL</span>
            </div>

            <div id = "trade-box">
                <label for="trade">Select a Trade:</label>
                <select id="trade" name="trade" required>
                    <option value="none" disabled selected>Choose a trade</option>
                    <option value="welding">Welding</option>
                    <option value="automotive">Automotive</option>
                    <option value="manufacturing">Manufacturing</option>
                    <option value="carpentry">Carpentry</option>
                    <option value="mechatronics">Mechatronics</option>
                </select>
                <span class = "err" id = "err-trade">Select a trade</span>
            </div>

            <button type = "submit" id = "add-job-button">Add Job</button>
        </form>
    </main>
</body>
</html>
